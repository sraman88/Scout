# Firebase Web App config — from your Firebase project's
# Project Settings > General > Your apps > Web app.
# These are NOT secrets (Firebase's client-side config is meant to be
# public; the real security boundary is the Firestore security rules),
# but keep them in .env.local (gitignored) rather than committing them
# so they're easy to rotate per-environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
